{
    "python.analysis.extraPaths": [
        "${workspaceFolder}",
        "${workspaceFolder}/runtime",
        "${workspaceFolder}/runtime/launcher",
    ],
    "python.autoComplete.extraPaths": [
        "${workspaceFolder}",
        "${workspaceFolder}/runtime",
        "${workspaceFolder}/runtime/launcher",
    ],
    "python.envFile": "${workspaceFolder}/.env",
    "pylint.args": [
        "--init-hook=import sys; sys.path.append('${workspaceFolder}'); sys.path.append('${workspaceFolder/runtime}'); sys.path.append('${workspaceFolder}/runtime/launcher'); sys.path.append('${workspaceFolder}/runtime/launcher/configgen')"
    ]
}