#!/bin/bash
set -e
#
# Author: Manu Romero (manu4.2012@gmail.com)
#
# Hook system for retrobox project. Run scripts before/after running a game or a specific platform, or when retrobox launches/exits.
# Heavily inspired in Sebastiaan Meijer's (sebastiaan@passthroughpo.st) Qemuhooks script for KVM and VFIO
#
# A failing hook does not prevent the remaining hooks of the same
# platform/game/state from running. Each failure is reported on stderr and,
# once every hook has been attempted, retrohook exits with status 1.

PLATFORM="$1"
GAME="$2"
STATE="$3"
USERDATA="$(cd "$(dirname "${BASH_SOURCE[0]}")"/../.. && pwd)"

HOOKPATH="$USERDATA/resources/hooks/retrohook.d/$PLATFORM/$GAME/$STATE"
mkdir -p "$HOOKPATH"

failed=0

# Run a single hook if it is a non-empty executable file.
# A failure is reported and recorded in $failed, but never aborts the script.
run_hook() {
	local file="$1"
	local rc=0
	shift

	if [ -f "$file" ] &&
		[ -s "$file" ] &&
		[ -x "$file" ]; then
		"$file" "$@" || rc=$?
		if [ "$rc" -ne 0 ]; then
			echo "retrohook: hook failed (exit $rc): $file" >&2
			failed=1
		fi
	fi
}

if [ -f "$HOOKPATH" ]; then
	run_hook "$HOOKPATH" "$@"
elif [ -d "$HOOKPATH" ]; then
	while IFS= read -r file; do
		run_hook "$file" "$@"
	done < <(find -L "$HOOKPATH" -maxdepth 1 -type f -executable -print | sort)
fi

exit "$failed"
