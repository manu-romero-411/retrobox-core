#!/bin/sh
LOG="/tmp/retrobox-wayfire.log"
TTYSAVE=/tmp/retrobox-ttysave

mkdir -p "$(dirname "$LOG")"

log() { echo "$(date '+%Y-%m-%d %H:%M:%S') $*" >>"$LOG"; }

/var/penguin/juegos/retrobox/resources/wayfire/retrobox-switch-display &

monitor_and_kill() {
    EXIT_RETRY=2
    while pgrep -fi "$1" >/dev/null 2>&1; do
        EXIT_RETRY=$((EXIT_RETRY - 1))
        sleep 1
        if [ ${EXIT_RETRY} -eq 0 ]; then
            pgrep "$1" | xargs kill -9
        fi
    done
    log "$1 finalizado; saliendo de wayfire"
}

quit_wayfire() {
    monitor_and_kill emulationstation
    pkill -INT -x wayfire
    vt_origen=$(cat "${TTYSAVE}" 2>/dev/null || echo 1)
    sudo /usr/local/bin/go2tty "$vt_origen"
}

trap quit_wayfire EXIT

# Dar un poco de tiempo a labwc para arrancar
sleep 3

cd /var/penguin/juegos/retrobox || {
    log "No se pudo entrar en /var/penguin/juegos/retrobox"
    quit_wayfire
    exit 1
}

log "Iniciando launcher"
./retrobox.sh --debug >/tmp/retrobug.log 2>&1
log "retrobox terminó con código $?"
