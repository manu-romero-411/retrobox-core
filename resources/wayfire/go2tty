#!/bin/bash
# WRAPPER PARA chvt CON LÓGICA ADICIONAL PARA ARRANCAR OTRA SESIÓN BASH AHÍ
# FECHA: 9 de agosto de 2026

usage() {
    cat <<EOF
Uso: $(basename "$0") [-n] [-h] TTY

  TTY   Número de tty destino (1-12)
  -n    No parar el getty de tty8 al salir de ella
  -h    Muestra esta ayuda
EOF
}

# auto-elevación: si no somos root, re-ejecutar con sudo
if [ "$EUID" -ne 0 ]; then
    exec sudo "$0" "$@"
fi

NO_STOP=0

while getopts ":nh" opt; do
    case "$opt" in
        n) NO_STOP=1 ;;
        h) usage; exit 0 ;;
        \?) echo "Opción inválida: -$OPTARG" >&2; usage; exit 1 ;;
    esac
done
shift $(( OPTIND - 1 ))

# tras quitar las opciones, sólo debe quedar el número de tty
if [ $# -ne 1 ]; then
    usage
    exit 1
fi

TTY="$1"

# debe ser numérico y no superior a 12, número de F# que hay en los teclados
if ! [[ "$TTY" =~ ^[0-9]+$ ]] || [ "$TTY" -lt 1 ] || [ "$TTY" -gt 12 ]; then
    echo "TTY inválida: $TTY" >&2
    usage
    exit 1
fi

# si por casualidad cambiamos a la tty8, arrancar el shell de ahí.
# Editamos con systemctl edit getty@tty8.service, se debe quedar así:
#
#[Service]
#ExecStart=
#ExecStart=-/sbin/agetty --autologin manuel --noclear %I $TERM
#StartLimitIntervalSec=0
#
# (cambiando manuel por el nombre de usuario, y sin los comments delante xd)
#

if [ "$TTY" -eq 8 ]; then
    systemctl start getty@tty8.service
    chvt "$TTY"
else
    chvt "$TTY"
    if [ "$NO_STOP" -eq 0 ]; then
        systemctl stop getty@tty8.service
    fi
fi

exit 0

