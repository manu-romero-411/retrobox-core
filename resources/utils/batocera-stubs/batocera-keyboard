#!/bin/bash
# kde-keyboard: batocera-keyboard port for KDE Plasma 6 (X11 + Wayland)
#
# Storage: ~/.config/kxkbrc [Layout] LayoutList / VariantList / Use
#          (read/written with kreadconfig6 / kwriteconfig6, not batocera-settings-*)
# Live apply:
#   - X11 session   -> setxkbmap (works as in the original script)
#   - Wayland (KWin)-> no client protocol exists; we rewrite kxkbrc then send
#                      KWin's DBus "reconfigure" signal, same trick KDE's own
#                      keyboard KCM uses internally.
#
# NOTE: this only affects the current user's Plasma session. It does not
# change the SDDM greeter or the TTY/console layout (those live in
# localectl/vconsole.conf and need root). Ask if you want that too.

set -ux

CONF_GROUP="Layout"
CONF_KEY_LAYOUT="LayoutList"
CONF_KEY_VARIANT="VariantList"

# Candidate xkb rules files across distros/xkeyboard-config versions.
RULES_CANDIDATES=(
    "/usr/share/X11/xkb/rules/base.lst"
    "/usr/share/X11/xkb/rules/evdev.lst"
)

RULES_FILE=""
for f in "${RULES_CANDIDATES[@]}"; do
    if [ -f "$f" ]; then
        RULES_FILE="$f"
        break
    fi
done

if [ -z "$RULES_FILE" ]; then
    echo "Error: no xkb rules file found (checked: ${RULES_CANDIDATES[*]})" >&2
    exit 1
fi

function have() { command -v "$1" >/dev/null 2>&1; }

function get_current_layout() {
    local val
    val=$(kreadconfig6 --file "$HOME/.config/kxkbrc" --group "$CONF_GROUP" --key "$CONF_KEY_LAYOUT" 2>/dev/null)
    val="${val%%,*}"
    [ -z "$val" ] && val="us"
    echo "$val"
}

function get_current_variant() {
    local val
    val=$(kreadconfig6 --file "$HOME/.config/kxkbrc" --group "$CONF_GROUP" --key "$CONF_KEY_VARIANT" 2>/dev/null)
    val="${val%%,*}"
    echo "$val"
}

function list_layouts() {
    awk '
    BEGIN { in_section=0 }
    /^! layout/ { in_section=1; next }
    /^!/ { in_section=0 }
    in_section && NF > 0 {
        code=$1;
        $1="";
        sub(/^ */, "", $0);
        print code " " $0
    }
    ' "$RULES_FILE" | sort -k2
}

function list_variants() {
    local layout="$1"
    if [ -z "$layout" ]; then
        layout=$(get_current_layout)
    fi
    [ -z "$layout" ] && return
    awk -v layout="$layout" '
    BEGIN { in_section=0 }
    /^! variant/ { in_section=1; next }
    /^!/ { in_section=0 }
    in_section && NF > 0 {
        if ($2 == layout":") {
            code=$1;
            $1=""; $2="";
            sub(/^ */, "", $0);
            print code " " $0
        }
    }
    ' "$RULES_FILE" | sort -k2
}

function apply_runtime() {
    local layout="$1" variant="$2"

    case "${XDG_SESSION_TYPE:-}" in
        wayland)
            if have qdbus6; then
                qdbus6 org.kde.KWin /KWin reconfigure 2>/dev/null
            elif have qdbus; then
                qdbus org.kde.KWin /KWin reconfigure 2>/dev/null
            elif have dbus-send; then
                dbus-send --session --type=method_call \
                    --dest=org.kde.KWin /KWin org.kde.KWin.reconfigure 2>/dev/null
            else
                echo "Warning: no qdbus6/qdbus/dbus-send found, layout written but not applied live" >&2
            fi
            ;;
        x11|*)
            if have setxkbmap; then
                setxkbmap -layout "$layout" -variant "$variant" 2>/dev/null || true
            fi
            ;;
    esac
}

function set_layout(){
    LAYOUT="${2:-us}"
    VARIANT="${3:-}"
    [ "$VARIANT" == "none" ] && VARIANT=""

    kwriteconfig6 --file "$HOME/.config/kxkbrc" --group "$CONF_GROUP" --key "$CONF_KEY_LAYOUT" --value "$LAYOUT"
    kwriteconfig6 --file "$HOME/.config/kxkbrc" --group "$CONF_GROUP" --key "$CONF_KEY_VARIANT" --value "$VARIANT"
    kwriteconfig6 --file "$HOME/.config/kxkbrc" --group "Layout" --key "Use" --value "true"

    apply_runtime "$LAYOUT" "$VARIANT"
}

case "${1:-}" in
    list-layouts)
        list_layouts
        ;;
    list-variants)
        list_variants "${2:-}"
        ;;
    get)
        L=$(get_current_layout)
        V=$(get_current_variant)
        echo "$L $V"
        ;;
    set)
        set_layout "${@}"
        ;;
    *)
        echo "Usage: $0 {list-layouts|list-variants [layout]|get|set <layout> <variant>}"
        exit 1
        ;;
esac
