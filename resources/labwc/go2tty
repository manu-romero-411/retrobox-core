#!/usr/bin/env bash
# chvt wrapper with extra logic to start/stop the gaming TTY's getty and
# the NVIDIA power daemon on the way in and out of the gaming session.
# Installed system-wide as a symlink at /usr/local/bin/go2tty by
# setup/utils/labwc-config.sh; "readlink -f" below resolves that symlink
# back to the checkout, so no path is hardcoded.
#
# Starting the gaming TTY's getty is what boots the session: the
# autologin shell sources ~/.bashrc.d/64_retrobox, which execs
# retrobox-labwc-session on that TTY.
#
# Usage: go2tty [-n] [-h] TTY
#   TTY   Target VT number (1-12)
#   -n    Don't stop the gaming TTY's getty when leaving it
#   -h    Show this help
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")" &>/dev/null && pwd -P)"
readonly SCRIPT_DIR
# shellcheck source=resources/labwc/retrobox-labwc-common.sh
source "${SCRIPT_DIR}/retrobox-labwc-common.sh"

usage() {
  cat <<EOF
Usage: $(basename "$0") [-n] [-h] TTY

  TTY   Target VT number (1-12)
  -n    Don't stop the gaming TTY's getty when leaving it
  -h    Show this help
EOF
}

# Re-exec under sudo if not already root.
if ((EUID != 0)); then
  exec sudo "$0" "$@"
fi

no_stop=0

while getopts ":nh" opt; do
  case "${opt}" in
    n) no_stop=1 ;;
    h)
      usage
      exit 0
      ;;
    \?)
      echo "Invalid option: -${OPTARG}" >&2
      usage
      exit 1
      ;;
  esac
done
shift $((OPTIND - 1))

if (($# != 1)); then
  usage
  exit 1
fi

readonly TARGET_TTY="$1"

if ! is_valid_tty "${TARGET_TTY}"; then
  echo "Invalid TTY: ${TARGET_TTY}" >&2
  usage
  exit 1
fi

GAMING_TTY="$(get_gaming_tty)" || exit 1
readonly GAMING_TTY

# Entering the gaming TTY: make sure its getty and the NVIDIA power
# daemon (needed for the dGPU to behave correctly across VT switches)
# are running.
#
# One-time setup: to enable autologin on the gaming TTY, run
#   systemctl edit "getty@tty${GAMING_TTY}.service"
# and set:
#   [Service]
#   ExecStart=
#   ExecStart=-/sbin/agetty --autologin <user> --noclear %I $TERM
#   StartLimitIntervalSec=0
if ((TARGET_TTY == GAMING_TTY)); then
  systemctl is-active --quiet "getty@tty${GAMING_TTY}.service" ||
    systemctl start "getty@tty${GAMING_TTY}.service"
  systemctl is-active --quiet nvidia-powerd.service ||
    systemctl start nvidia-powerd.service
  chvt "${TARGET_TTY}"
else
  chvt "${TARGET_TTY}"
  if systemctl is-active --quiet nvidia-powerd.service; then
    systemctl stop nvidia-powerd.service
  fi
  if ((no_stop == 0)); then
    # Stopping the getty tears down the autologin shell (and with it the
    # finished session) so it is not respawned on the gaming TTY.
    if systemctl is-active --quiet "getty@tty${GAMING_TTY}.service"; then
      systemctl stop "getty@tty${GAMING_TTY}.service"
    fi
  fi
fi

exit 0
