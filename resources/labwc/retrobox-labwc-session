#!/usr/bin/env bash
# Runs the labwc gaming session on the gaming TTY and, once retrobox.sh
# ends, closes labwc for good and returns to the original TTY.
#
# This script is exec'd by ~/.bashrc.d/64_retrobox from the autologin
# shell of the TTY configured in retrobox.ini ([advanced] labwc_tty), so
# it runs in the foreground, attached to that VT — that is what gives
# labwc a seat.
#
# labwc's "-s" is deliberately not used: labwc only ties its lifetime to
# the startup command when that command is itself the primary Wayland
# client, which retrobox.sh (a wrapper that spawns the real clients) is
# not — so the compositor outlived the session. Instead labwc and
# retrobox.sh are started side by side inside one D-Bus session and
# whichever ends first takes the other down with it.
#
# Usage: retrobox-labwc-session [-f]
#   -f        Skip the "am I on the gaming TTY?" check.
#   --inner   Internal: the part that runs inside dbus-run-session.
set -uo pipefail # no "-e": the TTY handoff below must always run

SELF="$(readlink -f -- "${BASH_SOURCE[0]}")"
readonly SELF
SCRIPT_DIR="$(dirname -- "${SELF}")"
readonly SCRIPT_DIR
# shellcheck source=resources/labwc/retrobox-labwc-common.sh
source "${SCRIPT_DIR}/retrobox-labwc-common.sh"

readonly LOG_FILE="${RETROBOX_LABWC_LOG:-/tmp/retrobox-labwc.log}"
# How long to wait for a process to honour SIGTERM before SIGKILL.
readonly TERM_GRACE_SECS=5
# How long to wait for labwc's Wayland socket to show up.
readonly SOCKET_WAIT_SECS=15

log() {
  printf '%s %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" >>"${LOG_FILE}"
}

# stop_pid PID NAME — SIGTERM, then SIGKILL if it won't go away.
stop_pid() {
  local pid="$1"
  local name="$2"
  local i

  kill -0 "${pid}" 2>/dev/null || return 0

  log "stopping ${name} (pid ${pid})"
  kill -TERM "${pid}" 2>/dev/null

  for ((i = 0; i < TERM_GRACE_SECS * 4; i++)); do
    kill -0 "${pid}" 2>/dev/null || return 0
    sleep 0.25
  done

  log "${name} ignored SIGTERM; killing it"
  kill -KILL "${pid}" 2>/dev/null
  wait "${pid}" 2>/dev/null
}

# ---------------------------------------------------------------------
# Inner half: runs inside dbus-run-session, owns labwc and retrobox.sh.
# ---------------------------------------------------------------------
run_session() {
  local runtime_dir="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
  local labwc_pid app_pid app_status=0 i sock

  # Remember which Wayland sockets already existed so the new one can be
  # told apart (labwc picks its name with wl_display_add_socket_auto).
  local before=()
  mapfile -t before < <(cd "${runtime_dir}" 2>/dev/null && ls -1 | grep -E '^wayland-[0-9]+$' || true)

  log "starting labwc"
  labwc &
  labwc_pid=$!

  # Wait for the compositor to be up before launching anything into it.
  local display=""
  for ((i = 0; i < SOCKET_WAIT_SECS * 10; i++)); do
    if ! kill -0 "${labwc_pid}" 2>/dev/null; then
      log "labwc died before creating its socket"
      wait "${labwc_pid}" 2>/dev/null
      return 1
    fi
    while read -r sock; do
      [[ -z "${sock}" ]] && continue
      local known=0 prev
      for prev in ${before[@]+"${before[@]}"}; do
        [[ "${prev}" == "${sock}" ]] && known=1
      done
      ((known == 0)) && display="${sock}"
    done < <(cd "${runtime_dir}" 2>/dev/null && ls -1 | grep -E '^wayland-[0-9]+$' || true)
    [[ -n "${display}" ]] && break
    sleep 0.1
  done

  if [[ -z "${display}" ]]; then
    log "timed out waiting for labwc's Wayland socket"
    stop_pid "${labwc_pid}" "labwc"
    return 1
  fi

  export WAYLAND_DISPLAY="${display}"
  log "labwc ready on ${WAYLAND_DISPLAY} (pid ${labwc_pid}); starting retrobox.sh"

  "${RETROBOX_ROOT}/retrobox.sh" &
  app_pid=$!

  # Whichever of the two ends first ends the session.
  while :; do
    if ! kill -0 "${app_pid}" 2>/dev/null; then
      wait "${app_pid}" 2>/dev/null
      app_status=$?
      log "retrobox.sh exited with status ${app_status}; closing labwc"
      break
    fi
    if ! kill -0 "${labwc_pid}" 2>/dev/null; then
      wait "${labwc_pid}" 2>/dev/null
      log "labwc exited on its own; stopping retrobox.sh"
      stop_pid "${app_pid}" "retrobox.sh"
      return 0
    fi
    sleep 0.25
  done

  stop_pid "${labwc_pid}" "labwc"
  return "${app_status}"
}

if (($# == 1)) && [[ "$1" == "--inner" ]]; then
  run_session
  exit $?
fi

force=0
if (($# == 1)) && [[ "$1" == "-f" ]]; then
  force=1
elif (($# > 0)); then
  echo "usage: $(basename "${BASH_SOURCE[0]}") [-f]" >&2
  exit 1
fi

GAMING_TTY="$(get_gaming_tty)" || exit 1
readonly GAMING_TTY

if ((force == 0)); then
  current_tty="$(get_current_tty || true)"
  if [[ "${current_tty}" != "${GAMING_TTY}" ]]; then
    echo "error: the session must be started from tty${GAMING_TTY}" \
      "(currently on ${current_tty:-a non-VT terminal}); use" \
      "retrobox-enter-tty, or -f to override" >&2
    exit 1
  fi
fi

if pgrep -x labwc >/dev/null 2>&1; then
  echo "error: labwc is already running" >&2
  exit 1
fi

# Keep the session's D-Bus activation environment out of the Plasma one.
export LABWC_UPDATE_ACTIVATION_ENV=off

# Backstop: whatever ends this script — retrobox.sh finishing, labwc
# being closed by hand, this being signalled — no labwc is left behind
# and the VT goes back to whoever called retrobox-enter-tty. Runs once.
handoff_done=0
finish() {
  ((handoff_done == 1)) && return 0
  handoff_done=1

  kill_labwc

  log "returning to the original TTY"
  # No -n: stops this TTY's getty too, so the autologin shell isn't
  # respawned into another session right after this one ended.
  "${SCRIPT_DIR}/retrobox-exit-tty" >>"${LOG_FILE}" 2>&1
}

# Terminates any labwc left behind and waits for it to actually die,
# escalating to SIGKILL. Covers the case where the inner half was killed
# before it could clean up.
kill_labwc() {
  local i
  pgrep -x labwc >/dev/null 2>&1 || return 0

  log "labwc still running; asking it to exit"
  pkill -x labwc 2>/dev/null

  for ((i = 0; i < TERM_GRACE_SECS * 4; i++)); do
    pgrep -x labwc >/dev/null 2>&1 || {
      log "labwc closed"
      return 0
    }
    sleep 0.25
  done

  log "labwc didn't exit; killing it"
  pkill -KILL -x labwc 2>/dev/null
  for ((i = 0; i < 8; i++)); do
    pgrep -x labwc >/dev/null 2>&1 || break
    sleep 0.25
  done
}

trap finish EXIT
trap 'exit 143' TERM INT HUP

log "Starting labwc gaming session on tty${GAMING_TTY} (root: ${RETROBOX_ROOT})"
dbus-run-session -- "${SELF}" --inner >>"${LOG_FILE}" 2>&1
exit_status=$?
log "session ended with status ${exit_status}"

finish
exit "${exit_status}"
