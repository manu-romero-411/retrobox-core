<?xml version="1.0" encoding="UTF-8"?>
<labwc_config>
  <keyboard>
    <!-- Cambiar pantallas y salidas de audio -->
    <keybind key="W-p">
      <action name="Execute">
        <command>/var/penguin/juegos/retrobox/resources/labwc/retrobox-switch-display toggle</command>
      </action>
    </keybind>
    <keybind key="W-o">
      <action name="Execute">
        <command>/var/penguin/juegos/retrobox/resources/labwc/retrobox-switch-audio-out toggle</command>
      </action>
    </keybind>
    <!-- Cambiar a Plasma -->
    <keybind key="W-d">
      <action name="Execute">
        <command>/var/penguin/juegos/retrobox/resources/labwc/retrobox-exit-tty -n</command>
      </action>
    </keybind>
    <!-- Cerrar ventana activa -->
    <keybind key="A-F4">
      <action name="Close"/>
    </keybind>
    <!-- Cambiar entre ventanas -->
    <keybind key="A-Tab">
      <action name="NextWindow"/>
    </keybind>
    <keybind key="A-S-Tab">
      <action name="PreviousWindow"/>
    </keybind>
    <!-- Volumen PipeWire: salida principal -->
    <keybind key="XF86AudioRaiseVolume">
      <action name="Execute">
        <command>wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+</command>
      </action>
    </keybind>
    <keybind key="XF86AudioLowerVolume">
      <action name="Execute">
        <command>wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-</command>
      </action>
    </keybind>
    <keybind key="XF86AudioMute">
      <action name="Execute">
        <command>wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle</command>
      </action>
    </keybind>
    <!-- Silenciar micrófono, opcional -->
    <keybind key="XF86AudioMicMute">
      <action name="Execute">
        <command>wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle</command>
      </action>
    </keybind>
    <!-- Terminal opcional -->
    <keybind key="W-t">
      <action name="Execute">
        <command>kitty</command>
      </action>
    </keybind>
    <!-- Salir de labwc manualmente -->
    <keybind key="W-S-e">
      <action name="Exit"/>
    </keybind>
    <!-- screenshots -->
    <keybind key="Print">
      <action name="Execute">
        <command>/var/penguin/juegos/retrobox/resources/utils/retrobox-screenshot</command>
      </action>
    </keybind>
    <layoutFiles enabled="no"/>
    <default/>
    <repeatRate>25</repeatRate>
    <repeatDelay>600</repeatDelay>
    <layout>es</layout>
  </keyboard>
</labwc_config>
