#!/usr/bin/env bash
# Switches to the configured gaming TTY (retrobox.ini, [advanced]
# labwc_tty). Starting that TTY's getty makes agetty autologin, and the
# autologin shell sources ~/.bashrc.d/64_retrobox, which execs
# retrobox-labwc-session *on that TTY* — that is where the whole
# environment lives now, so nothing is launched from here.
#
# Meant to be run from within Plasma; returns immediately. Use Win+D (or
# retrobox-exit-tty -n) from inside labwc to come back.
#
# Usage: retrobox-enter-tty
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")" &>/dev/null && pwd -P)"
readonly SCRIPT_DIR
# shellcheck source=resources/labwc/retrobox-labwc-common.sh
source "${SCRIPT_DIR}/retrobox-labwc-common.sh"

if (($# > 0)); then
  echo "usage: $(basename "${BASH_SOURCE[0]}")" >&2
  exit 1
fi

GAMING_TTY="$(get_gaming_tty)" || exit 1
readonly GAMING_TTY

# Remember the VT we're coming from so retrobox-exit-tty (and the
# session wrapper, once labwc exits) can return to it.
origin_tty="$(sed 's/tty//' /sys/class/tty/tty0/active)"
if is_valid_tty "${origin_tty}" && ((origin_tty != GAMING_TTY)); then
  printf '%s' "${origin_tty}" >"${RETROBOX_TTYSAVE}"
fi

echo "Switching to TTY ${GAMING_TTY} (the labwc session starts there)..."
exec sudo /usr/local/bin/go2tty "${GAMING_TTY}"
