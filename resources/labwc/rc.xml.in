<?xml version="1.0" encoding="UTF-8"?>
<!-- Generated from rc.xml.in by setup/utils/labwc-config.sh - do not edit. -->
<labwc_config>
  <keyboard>
    <!-- Switch display output and audio sink -->
    <keybind key="W-p">
      <action name="Execute">
        <command>@RETROBOX_ROOT@/resources/labwc/retrobox-switch-display toggle</command>
      </action>
    </keybind>
    <keybind key="W-o">
      <action name="Execute">
        <command>@RETROBOX_ROOT@/resources/labwc/retrobox-switch-audio-out toggle</command>
      </action>
    </keybind>
    <!-- Switch back to Plasma -->
    <keybind key="W-d">
      <action name="Execute">
        <command>@RETROBOX_ROOT@/resources/labwc/retrobox-exit-tty -n</command>
      </action>
    </keybind>
    <!-- Close the active window -->
    <keybind key="A-F4">
      <action name="Close"/>
    </keybind>
    <!-- Cycle between windows -->
    <keybind key="A-Tab">
      <action name="NextWindow"/>
    </keybind>
    <keybind key="A-S-Tab">
      <action name="PreviousWindow"/>
    </keybind>
    <!-- PipeWire volume: default sink -->
    <keybind key="XF86AudioRaiseVolume">
      <action name="Execute">
        <command>wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+</command>
      </action>
    </keybind>
    <keybind key="XF86AudioLowerVolume">
      <action name="Execute">
        <command>wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-</command>
      </action>
    </keybind>
    <keybind key="XF86AudioMute">
      <action name="Execute">
        <command>wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle</command>
      </action>
    </keybind>
    <!-- Mute microphone, optional -->
    <keybind key="XF86AudioMicMute">
      <action name="Execute">
        <command>wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle</command>
      </action>
    </keybind>
    <!-- Optional terminal -->
    <keybind key="W-t">
      <action name="Execute">
        <command>alacritty</command>
      </action>
    </keybind>
    <!-- Exit labwc manually -->
    <keybind key="W-S-e">
      <action name="Exit"/>
    </keybind>
    <!-- Screenshots -->
    <keybind key="Print">
      <action name="Execute">
        <command>@RETROBOX_ROOT@/resources/utils/retrobox-screenshot</command>
      </action>
    </keybind>
    <layoutFiles enabled="no"/>
    <default/>
    <repeatRate>25</repeatRate>
    <repeatDelay>600</repeatDelay>
    <layout>es</layout>
  </keyboard>
</labwc_config>
