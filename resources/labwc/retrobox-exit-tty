#!/usr/bin/env bash
# Switches back to the TTY retrobox-enter-tty was called from.
#
# Usage: retrobox-exit-tty [-n]
#   -n   Don't stop the gaming TTY's getty on the way out (see go2tty).
#        Use it when the labwc session must stay alive on its TTY, e.g.
#        the Win+D keybind that jumps back to Plasma.
#
# Without -n, go2tty stops the gaming TTY's getty as its very last step
# (after the chvt has already happened), which tears down the autologin
# shell that is running this very script — expected and harmless here,
# since by then there's nothing left to do.
#
# Always calls "sudo go2tty" directly (never wrapped in another command)
# so it matches a plain
#   <user> ALL=(root) NOPASSWD: /usr/local/bin/go2tty
# sudoers rule; wrapping it in anything else (systemd-run, etc.) makes
# sudo check permissions for that other command instead and prompts for
# a password no one is there to type.
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")" &>/dev/null && pwd -P)"
readonly SCRIPT_DIR
# shellcheck source=resources/labwc/retrobox-labwc-common.sh
source "${SCRIPT_DIR}/retrobox-labwc-common.sh"

keep_getty=0
if (($# == 1)) && [[ "$1" == "-n" ]]; then
  keep_getty=1
elif (($# > 0)); then
  echo "usage: $(basename "${BASH_SOURCE[0]}") [-n]" >&2
  exit 1
fi

if [[ -r "${RETROBOX_TTYSAVE}" ]]; then
  origin_tty="$(<"${RETROBOX_TTYSAVE}")"
else
  origin_tty="${RETROBOX_FALLBACK_TTY}"
  echo "warning: no saved TTY at ${RETROBOX_TTYSAVE}; falling back to tty${origin_tty}" >&2
fi

if ! is_valid_tty "${origin_tty}"; then
  echo "error: invalid origin TTY '${origin_tty}'" >&2
  exit 1
fi

if ((keep_getty == 1)); then
  sudo /usr/local/bin/go2tty -n "${origin_tty}"
else
  rm -f "${RETROBOX_TTYSAVE}"
  sudo /usr/local/bin/go2tty "${origin_tty}"
fi
