# Generated from autostart.in by setup/utils/labwc-config.sh — do not edit.

# Report the environment labwc sets up for its children to
# retrobox-labwc-session, which starts retrobox.sh outside labwc's process
# tree and needs it (DISPLAY for Ryujinx/Eden, XDG_SESSION_TYPE, ...).
# Written atomically: the session script waits for this file to appear.
if [ -n "${RETROBOX_LABWC_ENV_FILE:-}" ]; then
  env | grep -E '^(DISPLAY|WAYLAND_DISPLAY|XDG_SESSION_TYPE|XDG_CURRENT_DESKTOP|LABWC_PID)=' \
    >"${RETROBOX_LABWC_ENV_FILE}.tmp" &&
    mv "${RETROBOX_LABWC_ENV_FILE}.tmp" "${RETROBOX_LABWC_ENV_FILE}"
fi

# Pick the active display output for the gaming session.
@RETROBOX_ROOT@/resources/labwc/retrobox-switch-display &
