#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &>/dev/null && pwd)"
readonly SCRIPT_DIR

readonly HDMI="HDMI-A-1"
readonly EDP="eDP-1"

get_enabled() {
  local mon="$1"
  wlr-randr | awk -v mon="${mon}" '
    $0 ~ "^"mon" " {found=1}
    found && /^[^[:space:]]/ && $0 !~ "^"mon" " {exit}
    found && /Enabled:/ {print $2; exit}
  '
}

output="$(wlr-randr)"

# If HDMI isn't even connected, only the laptop panel is available.
if ! grep -q "^${HDMI} " <<<"${output}"; then
  wlr-randr --output "${EDP}" --on --preferred --pos 0,0
  "${SCRIPT_DIR}/retrobox-switch-audio-out" laptop
  exit 0
fi

hdmi_state="$(get_enabled "${HDMI}")"
edp_state="$(get_enabled "${EDP}")"

if [[ "${hdmi_state}" == "yes" && "${edp_state}" == "no" ]]; then
  # Special case: HDMI is the only active output -> fall back to the laptop.
  wlr-randr --output "${HDMI}" --off
  wlr-randr --output "${EDP}" --on --preferred --pos 0,0
  "${SCRIPT_DIR}/retrobox-switch-audio-out" laptop
else
  # Default case: enable HDMI at 1080p60, disable the laptop panel.
  wlr-randr --output "${EDP}" --off
  wlr-randr --output "${HDMI}" --on --preferred --pos 0,0
  sleep 3
  "${SCRIPT_DIR}/retrobox-switch-audio-out" hdmi
fi
