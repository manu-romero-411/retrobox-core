# IDEs AND TOOLS
# ==============================================================================
.vscode/launch.json
.aider*
*.pdf

# ==============================================================================
# RETROBOX: RUNTIME AND USER DATA
# ==============================================================================
# Ignore content, but keep directory trackable for exceptions
/bios/*
!/bios/bios_core_overrides.yaml
/bios_ld/
/cheats/
/emuconfigs/
/emulators/
/roms/
/saves/
/screenshots/
/shaders/

# Decorations (ignore root, allow submodule in resources)
/decorations/
!/resources/decorations/

# ==============================================================================
# RETROBOX: FRONTEND (RUNTIME)
# ==============================================================================
/frontend/emulationstation*
/frontend/.emulationstation/music/
/frontend/.emulationstation/tmp/
/frontend/.emulationstation/resources/
/frontend/.emulationstation/recovery/
/frontend/.emulationstation/es_log.*
/frontend/.emulationstation/es_settings.*
/frontend/.emulationstation/es_*input*
/frontend/.emulationstation/es_systems*.*
/frontend/.emulationstation/es_features*.*
/frontend/.emulationstation/emulationstation.ini
/frontend/music/
/frontend/locale/
/frontend/resources/
/frontend/share/

# Themes: ignore all except specific ones
/frontend/themes/*
!/frontend/themes/es-theme-iconic/
!/frontend/themes/ES-THEME-ARCADEPLANET/

# ==============================================================================
# RETROBOX: RESOURCES AND LOGS
# ==============================================================================
/logs/
/resources/alsa/
/resources/datainit/
/resources/audio_filters/
/resources/video_filters/
/setup/.packages/

# ==============================================================================
# RETROBOX: HOOKS (Ignore all, except explicit exceptions)
# ==============================================================================
/resources/hooks/retrohook.d/**

# Exceptions: _global/_platform/ hierarchy
!/resources/hooks/retrohook.d/_global/
!/resources/hooks/retrohook.d/_global/_platform/
!/resources/hooks/retrohook.d/_global/_platform/**

# Exceptions: frontend setup hook
!/resources/hooks/retrohook.d/_frontend/
!/resources/hooks/retrohook.d/_frontend/emulationstation/
!/resources/hooks/retrohook.d/_frontend/emulationstation/on-frontend-start/
!/resources/hooks/retrohook.d/_frontend/emulationstation/on-frontend-start/00_setup.sh

# ==============================================================================
# RETROBOX: MISCELLANEOUS
# ==============================================================================
*.AppImage
*.gbc
*.gb
/.retrobox_setup_done
/.retrobox_emulationstation.version
/retrobox.ini